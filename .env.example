# Neon Postgres - obtené el connection string desde https://console.neon.tech
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres random)
# Generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="reemplazar-por-un-string-random-de-al-menos-32-caracteres"

# Groq API key - https://console.groq.com/keys
GROQ_API_KEY=""

# Saltea el login en desarrollo. Ignorado si NODE_ENV=production.
DEV_SKIP_LOGIN="true"